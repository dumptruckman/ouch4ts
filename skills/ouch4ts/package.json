{
  "name": "ouch4ts",
  "version": "0.1.0",
  "description": "OUCH scores for TypeScript functions, with an agent skill",
  "type": "module",
  "bin": {
    "ouch4ts": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "SKILL.md",
    "agents",
    "references"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ouch": "npm run build --silent && node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
